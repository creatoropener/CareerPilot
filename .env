# Set this in Vercel Project Settings > Environment Variables (Production, Preview, Development).
# For local `vercel dev`, put it in a git-ignored .env.local file.
# Do not add a real API key to this file or commit it to GitHub.
TAVILY_API_KEY=

# Optional AI explanations (NVIDIA Nemotron on Nebius Token Factory, OpenAI-compatible API).
NEBIUS_API_KEY=
# Optional overrides. Defaults shown.
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
